    "@decky/rollup": "^1.0.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "rollup": "^4.20.0",
    "shx": "^0.3.4",
    "typescript": "^5.5.4"
  }
}
